<%@ Page Title="Edit ticket" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Edit.aspx.vb" Inherits="ITSupportAssetManagement.Web.TicketEditPage" %>
<asp:Content ID="TicketEditContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading ticket-page-heading"><div><asp:HyperLink ID="BackLink" runat="server" CssClass="back-link"><i class="bi bi-arrow-left"></i> Back to ticket</asp:HyperLink><h1>Edit ticket</h1><p>Correct classification, priority, and request information.</p></div></div>
<asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
<section class="panel edit-form"><div class="form-body"><div class="form-row"><div class="field"><label>Category</label><asp:DropDownList ID="CategoryInput" runat="server" /></div><div class="field"><label>Priority</label><asp:DropDownList ID="PriorityInput" runat="server"><asp:ListItem>Low</asp:ListItem><asp:ListItem>Medium</asp:ListItem><asp:ListItem>High</asp:ListItem><asp:ListItem>Critical</asp:ListItem></asp:DropDownList></div></div><div class="field"><label>Related asset</label><asp:DropDownList ID="AssetInput" runat="server" /></div><div class="field"><label>Title</label><asp:TextBox ID="TitleInput" runat="server" MaxLength="180" /></div><div class="field"><label>Description</label><asp:TextBox ID="DescriptionInput" runat="server" TextMode="MultiLine" Rows="8" /></div></div><div class="edit-actions"><asp:HyperLink ID="CancelLink" runat="server" CssClass="button button-secondary">Cancel</asp:HyperLink><asp:Button ID="SaveButton" runat="server" Text="Save ticket" CssClass="button button-primary" /></div></section>
</asp:Content>
