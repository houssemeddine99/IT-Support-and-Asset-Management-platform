<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.Master.vb" Inherits="ITSupportAssetManagement.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <title><%: Page.Title %> - NexaDesk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/site.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="MainForm" runat="server">
        <div class="app-shell">
            <aside class="sidebar" id="AppSidebar" aria-label="Main navigation">
                <div class="brand"><span class="brand-mark"><i class="bi bi-command"></i></span><span class="brand-copy"><strong>NexaDesk</strong><small>IT Operations</small></span></div>
                <nav class="sidebar-nav">
                    <p class="nav-caption">Workspace</p>
                    <a class="nav-link active" href="<%= ResolveUrl("~/Default.aspx") %>"><i class="bi bi-grid-1x2-fill"></i><span>Overview</span></a>
                    <a class="nav-link" href="<%= ResolveUrl("~/Tickets/List.aspx") %>"><i class="bi bi-inbox"></i><span>Tickets</span><em>12</em></a>
                    <a class="nav-link" href="<%= ResolveUrl("~/Assets/List.aspx") %>"><i class="bi bi-laptop"></i><span>Assets</span></a>
                    <a class="nav-link" href="#maintenance"><i class="bi bi-tools"></i><span>Maintenance</span><em class="warning">3</em></a>
                    <p class="nav-caption">Management</p>
                    <a class="nav-link" href="#team"><i class="bi bi-people"></i><span>Team</span></a>
                    <a class="nav-link" href="#reports"><i class="bi bi-bar-chart"></i><span>Reports</span></a>
                    <a class="nav-link" href="#settings"><i class="bi bi-gear"></i><span>Settings</span></a>
                </nav>
                <div class="sidebar-footer"><div class="storage-copy"><span>Asset capacity</span><strong>78%</strong></div><div class="progress-track"><span style="width: 78%"></span></div><small>312 of 400 assets registered</small></div>
            </aside>
            <div class="sidebar-scrim" id="SidebarScrim"></div>
            <div class="app-main">
                <header class="topbar">
                    <button class="icon-button menu-button" id="MenuButton" type="button" aria-label="Open navigation" aria-expanded="false"><i class="bi bi-list"></i></button>
                    <div class="search-box"><i class="bi bi-search"></i><input type="search" placeholder="Search tickets, assets, or people..." aria-label="Search" /><kbd>⌘ K</kbd></div>
                    <div class="topbar-actions"><button class="icon-button notification-button" type="button" aria-label="Notifications"><i class="bi bi-bell"></i><span></span></button><div class="profile"><span class="avatar"><asp:Literal ID="UserInitials" runat="server" /></span><span class="profile-copy"><strong><asp:Literal ID="UserDisplayName" runat="server" /></strong><small><asp:Literal ID="UserRole" runat="server" /></small></span><a class="logout-link" href="<%= ResolveUrl("~/Logout.aspx") %>" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></a></div></div>
                </header>
                <main class="content-area"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
            </div>
        </div>
    </form>
    <script src="<%= ResolveUrl("~/Scripts/app.js") %>"></script>
</body>
</html>
