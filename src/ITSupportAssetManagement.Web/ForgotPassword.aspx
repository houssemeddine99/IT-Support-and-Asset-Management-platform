<%@ Page Title="Forgot password" Language="VB" AutoEventWireup="false" CodeBehind="ForgotPassword.aspx.vb" Inherits="ITSupportAssetManagement.Web.ForgotPasswordPage" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Recover account - Siliana IT Hub</title><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@700;800&amp;display=swap" rel="stylesheet" /><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" /><link href="Content/auth.css?v=20260902.1" rel="stylesheet" /></head>
<body><form id="RecoveryForm" runat="server" class="auth-shell login-template"><section class="auth-showcase"><div class="showcase-art" aria-hidden="true"></div><a class="auth-brand" href="Login.aspx"><img src="Content/Images/draexlmaier-logo.png" alt="DRÄXLMAIER" /><small>Siliana IT Hub</small></a><div class="showcase-copy"><span class="showcase-kicker">Secure account recovery</span><h1>Get back to work without compromising your account.</h1><p>Reset links expire after 30 minutes and can be used only once.</p></div></section><section class="auth-form-panel"><div class="auth-card recovery-card"><a class="auth-back" href="Login.aspx"><i class="bi bi-arrow-left"></i> Back to sign in</a><p class="eyebrow">Account recovery</p><h2>Forgot your password?</h2><p class="auth-intro">Enter your work email and we will send a secure reset link.</p><asp:Panel ID="ResultPanel" runat="server" CssClass="auth-alert success" Visible="false"><i class="bi bi-check-circle"></i>If an active account matches that email, a reset link has been sent.</asp:Panel><asp:Panel ID="ErrorPanel" runat="server" CssClass="auth-alert" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel><div class="field"><label for="EmailInput">Work email</label><div class="input-wrap"><i class="bi bi-envelope"></i><asp:TextBox ID="EmailInput" runat="server" TextMode="Email" MaxLength="254" autocomplete="email" /></div><asp:RequiredFieldValidator ID="EmailRequired" runat="server" ControlToValidate="EmailInput" ErrorMessage="Email is required." CssClass="field-error" Display="Dynamic" /></div><asp:Button ID="SendButton" runat="server" Text="Send reset link" CssClass="auth-button" /></div></section></form></body></html>
