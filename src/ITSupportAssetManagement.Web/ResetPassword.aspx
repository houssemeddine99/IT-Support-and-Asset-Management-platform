<%@ Page Title="Reset password" Language="VB" AutoEventWireup="false" CodeBehind="ResetPassword.aspx.vb" Inherits="ITSupportAssetManagement.Web.ResetPasswordPage" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Reset password - Siliana IT Hub</title><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@700;800&amp;display=swap" rel="stylesheet" /><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" /><link href="Content/auth.css?v=20260902.1" rel="stylesheet" /></head>
<body><form id="ResetForm" runat="server" class="auth-shell login-template"><section class="auth-showcase"><div class="showcase-art" aria-hidden="true"></div><a class="auth-brand" href="Login.aspx"><img src="Content/Images/draexlmaier-logo.png" alt="DRÄXLMAIER" /><small>Siliana IT Hub</small></a><div class="showcase-copy"><span class="showcase-kicker">Protected credentials</span><h1>Create a strong new password for your workspace.</h1><p>Your reset link is single-use and expires automatically.</p></div></section><section class="auth-form-panel"><div class="auth-card recovery-card"><p class="eyebrow">Account recovery</p><h2>Choose a new password</h2><p class="auth-intro">Use 12+ characters with uppercase, lowercase, a number, and a symbol.</p><asp:Panel ID="InvalidPanel" runat="server" CssClass="auth-alert" Visible="false"><i class="bi bi-exclamation-circle"></i>This reset link is invalid or has expired. <a href="ForgotPassword.aspx">Request another link</a>.</asp:Panel><asp:Panel ID="FormPanel" runat="server"><asp:Panel ID="ErrorPanel" runat="server" CssClass="auth-alert" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel><div class="field"><label for="PasswordInput">New password</label><div class="input-wrap"><i class="bi bi-lock"></i><asp:TextBox ID="PasswordInput" runat="server" TextMode="Password" MaxLength="128" autocomplete="new-password" /></div></div><div class="field"><label for="ConfirmInput">Confirm password</label><div class="input-wrap"><i class="bi bi-shield-lock"></i><asp:TextBox ID="ConfirmInput" runat="server" TextMode="Password" MaxLength="128" autocomplete="new-password" /></div></div><asp:Button ID="ResetButton" runat="server" Text="Reset password" CssClass="auth-button" /></asp:Panel></div></section></form></body></html>
