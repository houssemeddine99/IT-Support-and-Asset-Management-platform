<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <connectionStrings>
    <add name="ITSupportDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ITSupportAssetManagement;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" strict="true" explicit="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="en-US" uiCulture="en" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="60" slidingExpiration="true" protection="All" requireSSL="false" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <sessionState cookieSameSite="Lax" timeout="60" />
  </system.web>
  <location path="Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="SetupAdmin.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Content">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
</configuration>
