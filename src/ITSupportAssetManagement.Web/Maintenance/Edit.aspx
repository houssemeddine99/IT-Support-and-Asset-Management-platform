<%@ Page Title="Edit intervention" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Edit.aspx.vb" Inherits="ITSupportAssetManagement.Web.MaintenanceEditPage" %>
<asp:Content ID="MaintenanceEditContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading ticket-page-heading"><div><asp:HyperLink ID="BackLink" runat="server" CssClass="back-link"><i class="bi bi-arrow-left"></i> Back to intervention</asp:HyperLink><h1>Edit intervention</h1><p>Adjust ownership, schedule, provider, and technical scope.</p></div></div><asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
<section class="panel edit-form"><div class="form-body"><div class="form-row"><div class="field"><label>Intervention type</label><asp:DropDownList ID="TypeInput" runat="server"><asp:ListItem>Preventive</asp:ListItem><asp:ListItem>Corrective</asp:ListItem><asp:ListItem>Inspection</asp:ListItem><asp:ListItem>Upgrade</asp:ListItem></asp:DropDownList></div><div class="field"><label>Technician</label><asp:DropDownList ID="TechnicianInput" runat="server" /></div></div><div class="form-row"><div class="field"><label>Scheduled date and time</label><asp:TextBox ID="ScheduledInput" runat="server" TextMode="DateTimeLocal" /></div><div class="field"><label>External provider</label><asp:TextBox ID="ProviderInput" runat="server" MaxLength="150" /></div></div><div class="field"><label>Diagnosis or scope</label><asp:TextBox ID="DiagnosisInput" runat="server" TextMode="MultiLine" Rows="7" /></div></div><div class="edit-actions"><asp:HyperLink ID="CancelLink" runat="server" CssClass="button button-secondary">Cancel</asp:HyperLink><asp:Button ID="SaveButton" runat="server" Text="Save intervention" CssClass="button button-primary" /></div></section>
</asp:Content>
