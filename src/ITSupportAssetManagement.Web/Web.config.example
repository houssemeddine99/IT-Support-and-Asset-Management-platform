<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="AssetCapacity" value="400" />
    <!-- Use Pickup while developing. Reset emails are written to App_Data/MailPickup. -->
    <!-- Change Mail:Mode to Smtp and supply your organization's relay for production. -->
    <add key="Mail:Mode" value="Pickup" />
    <add key="Mail:From" value="siliana-it@company.example" />
    <add key="Mail:SmtpHost" value="smtp.company.example" />
    <add key="Mail:SmtpPort" value="587" />
    <add key="Mail:EnableSsl" value="true" />
    <add key="Mail:Username" value="" />
    <add key="Mail:Password" value="" />
    <!-- Optional Microsoft Entra ID sign-in. All three values are required to show the company sign-in button. -->
    <add key="Identity:TenantId" value="00000000-0000-0000-0000-000000000000" />
    <add key="Identity:ClientId" value="00000000-0000-0000-0000-000000000000" />
    <add key="Identity:ClientSecret" value="set-through-deployment-secrets" />
  </appSettings>
  <connectionStrings>
    <add name="ITSupportDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ITSupportAssetManagement;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
