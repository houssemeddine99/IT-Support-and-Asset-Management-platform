<%@ Page Title="Assign asset" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Assign.aspx.vb" Inherits="ITSupportAssetManagement.Web.AssetAssignPage" %>
<asp:Content ID="AssignAssetContent" ContentPlaceHolderID="MainContent" runat="server">
    <div class="page-heading ticket-page-heading"><div><a class="back-link" href='<%= "Details.aspx?id=" & Server.UrlEncode(Request.QueryString("id")) %>'><i class="bi bi-arrow-left"></i> Back to asset</a><h1>Assign equipment</h1><p>Record who is responsible for this company asset.</p></div></div>
    <asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
    <div class="assignment-layout"><section class="panel assignment-form"><div class="assignment-asset"><span><i class="bi bi-laptop"></i></span><div><small>Asset to assign</small><strong><asp:Literal ID="AssetName" runat="server" /></strong><em><asp:Literal ID="AssetTag" runat="server" /></em></div></div><div class="form-body"><div class="field"><label for="UserInput">Assign to <em>Required</em></label><asp:DropDownList ID="UserInput" runat="server" /><asp:RequiredFieldValidator ID="UserRequired" runat="server" ControlToValidate="UserInput" InitialValue="" ErrorMessage="Select an employee." CssClass="field-error" Display="Dynamic" /></div><div class="field"><label for="NotesInput">Assignment notes</label><asp:TextBox ID="NotesInput" runat="server" TextMode="MultiLine" Rows="5" MaxLength="500" placeholder="Accessories issued, equipment condition, or custody instructions" /></div><label class="custody-check"><asp:CheckBox ID="ConfirmInput" runat="server" /><span>I confirm that this assignment reflects the physical equipment handover.</span></label><asp:CustomValidator ID="ConfirmValidator" runat="server" ErrorMessage="Confirm the equipment handover." CssClass="field-error" Display="Dynamic" /><div class="form-actions wide"><a class="button button-secondary" href='<%= "Details.aspx?id=" & Server.UrlEncode(Request.QueryString("id")) %>'>Cancel</a><asp:Button ID="AssignButton" runat="server" Text="Confirm assignment" CssClass="button button-primary" /></div></div></section><aside class="assignment-guidance"><div class="guidance-icon"><i class="bi bi-shield-check"></i></div><h2>Equipment custody</h2><p>The assignment history provides an auditable chain of responsibility for every asset at the Siliana site.</p><ul><li>Verify the asset tag physically</li><li>Select the correct employee</li><li>Record included accessories</li><li>Confirm the handover</li></ul></aside></div>
</asp:Content>

