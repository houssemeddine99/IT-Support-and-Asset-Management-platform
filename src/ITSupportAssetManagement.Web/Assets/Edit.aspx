<%@ Page Title="Edit asset" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Edit.aspx.vb" Inherits="ITSupportAssetManagement.Web.AssetEditPage" %>
<asp:Content ID="AssetEditContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading ticket-page-heading"><div><asp:HyperLink ID="BackLink" runat="server" CssClass="back-link"><i class="bi bi-arrow-left"></i> Back to asset</asp:HyperLink><h1>Edit asset</h1><p>Update identity, lifecycle, purchase, and location information.</p></div></div><asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
<section class="panel edit-form"><div class="form-body"><div class="form-row"><div class="field"><label>Asset tag</label><asp:TextBox ID="AssetTagInput" runat="server" MaxLength="40" /></div><div class="field"><label>Category</label><asp:DropDownList ID="CategoryInput" runat="server" /></div></div><div class="form-row"><div class="field"><label>Manufacturer</label><asp:TextBox ID="ManufacturerInput" runat="server" MaxLength="80" /></div><div class="field"><label>Model</label><asp:TextBox ID="ModelInput" runat="server" MaxLength="120" /></div></div><div class="form-row"><div class="field"><label>Serial number</label><asp:TextBox ID="SerialInput" runat="server" MaxLength="100" /></div><div class="field"><label>Location</label><asp:TextBox ID="LocationInput" runat="server" MaxLength="150" /></div></div><div class="form-row three"><div class="field"><label>Purchase date</label><asp:TextBox ID="PurchaseDateInput" runat="server" TextMode="Date" /></div><div class="field"><label>Purchase cost</label><asp:TextBox ID="PurchaseCostInput" runat="server" TextMode="Number" step="0.01" min="0" /></div><div class="field"><label>Warranty end</label><asp:TextBox ID="WarrantyInput" runat="server" TextMode="Date" /></div></div><div class="field"><label>Status</label><asp:DropDownList ID="StatusInput" runat="server"><asp:ListItem>Available</asp:ListItem><asp:ListItem>Assigned</asp:ListItem><asp:ListItem Value="InMaintenance">In maintenance</asp:ListItem><asp:ListItem>Retired</asp:ListItem><asp:ListItem>Lost</asp:ListItem></asp:DropDownList></div><div class="field"><label>Notes</label><asp:TextBox ID="NotesInput" runat="server" TextMode="MultiLine" Rows="5" MaxLength="1000" /></div></div><div class="edit-actions"><asp:HyperLink ID="CancelLink" runat="server" CssClass="button button-secondary">Cancel</asp:HyperLink><asp:Button ID="SaveButton" runat="server" Text="Save asset" CssClass="button button-primary" /></div></section>
</asp:Content>
