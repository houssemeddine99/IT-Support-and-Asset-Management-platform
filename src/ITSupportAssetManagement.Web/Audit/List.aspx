<%@ Page Title="Audit log" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="List.aspx.vb" Inherits="ITSupportAssetManagement.Web.AuditListPage" %>
<asp:Content ID="AuditContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading ticket-page-heading"><div><p class="eyebrow">Governance</p><h1>Audit log</h1><p>Trace important platform changes, actors, records, and request origins.</p></div></div><asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
<section class="panel audit-workspace"><div class="ticket-toolbar"><div class="filter-search"><i class="bi bi-search"></i><asp:TextBox ID="SearchInput" runat="server" MaxLength="180" placeholder="Search actor, record, or description" /></div><asp:DropDownList ID="EntityFilter" runat="server"><asp:ListItem Value="">All record types</asp:ListItem><asp:ListItem>Ticket</asp:ListItem><asp:ListItem>Asset</asp:ListItem><asp:ListItem>Maintenance</asp:ListItem><asp:ListItem>User</asp:ListItem><asp:ListItem>Setting</asp:ListItem></asp:DropDownList><asp:Button ID="FilterButton" runat="server" Text="Apply filters" CssClass="button button-secondary" /></div><div class="audit-list"><asp:Repeater ID="AuditRepeater" runat="server"><ItemTemplate><article><span class="audit-avatar"><%#: Eval("Initials") %></span><div><header><strong><%#: Eval("ActorName") %></strong><span><%#: Eval("ActionName") %></span><time><%#: CType(Eval("CreatedAtUtc"), DateTime).ToLocalTime().ToString("dd MMM yyyy, HH:mm") %></time></header><p><%#: Eval("Summary") %></p><small><i class="bi bi-database"></i> <%#: Eval("EntityType") %> <%#: Eval("EntityKey") %> · IP <%#: If(String.IsNullOrWhiteSpace(Convert.ToString(Eval("IpAddress"))), "unknown", Eval("IpAddress")) %></small></div></article></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server" CssClass="no-history" Visible="false">No matching audit activity.</asp:Panel></div><div class="table-footer"><span><asp:Literal ID="ResultCount" runat="server" /> events</span><small>Latest 250 events</small></div></section>
</asp:Content>
