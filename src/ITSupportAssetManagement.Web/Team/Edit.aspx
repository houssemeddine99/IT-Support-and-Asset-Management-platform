<%@ Page Title="Edit team member" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Edit.aspx.vb" Inherits="ITSupportAssetManagement.Web.TeamEditPage" %>
<asp:Content ID="TeamEditContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading ticket-page-heading"><div><a class="back-link" href="List.aspx"><i class="bi bi-arrow-left"></i> Back to team</a><h1>Edit team member</h1><p>Maintain identity, contact details, department, and platform role.</p></div></div><asp:Panel ID="SuccessPanel" runat="server" CssClass="page-alert success" Visible="false"><i class="bi bi-check-circle"></i><asp:Literal ID="SuccessMessage" runat="server" /></asp:Panel><asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
<section class="panel edit-form"><div class="form-body"><div class="form-row"><div class="field"><label>First name</label><asp:TextBox ID="FirstNameInput" runat="server" MaxLength="80" /></div><div class="field"><label>Last name</label><asp:TextBox ID="LastNameInput" runat="server" MaxLength="80" /></div></div><div class="form-row"><div class="field"><label>Employee code</label><asp:TextBox ID="EmployeeCodeInput" runat="server" MaxLength="30" /></div><div class="field"><label>Department</label><asp:TextBox ID="DepartmentInput" runat="server" MaxLength="100" /></div></div><div class="form-row"><div class="field"><label>Email</label><asp:TextBox ID="EmailInput" runat="server" TextMode="Email" MaxLength="254" /></div><div class="field"><label>Phone</label><asp:TextBox ID="PhoneInput" runat="server" MaxLength="30" /></div></div><div class="field"><label>Platform role</label><asp:DropDownList ID="RoleInput" runat="server" /><span class="field-help">Your own role cannot be changed while you are signed in.</span></div></div><div class="edit-actions"><a class="button button-secondary" href="List.aspx">Cancel</a><asp:Button ID="SaveButton" runat="server" Text="Save team member" CssClass="button button-primary" /></div></section>
<section class="panel edit-form admin-reset-card"><div class="panel-heading"><div><h2>Administrator password reset</h2><p>Issue a temporary password when the employee cannot sign in.</p></div><span class="settings-icon violet"><i class="bi bi-shield-lock"></i></span></div><div class="form-body"><div class="form-row"><div class="field"><label for="TemporaryPasswordInput">Temporary password <em>Required</em></label><asp:TextBox ID="TemporaryPasswordInput" runat="server" TextMode="Password" MaxLength="128" autocomplete="new-password" /><span class="field-help">12+ characters with uppercase, lowercase, number, and symbol.</span><asp:RequiredFieldValidator ID="TemporaryPasswordRequired" runat="server" ControlToValidate="TemporaryPasswordInput" ValidationGroup="ResetPassword" ErrorMessage="Enter a temporary password." CssClass="field-error" Display="Dynamic" /></div><div class="field"><label for="ConfirmTemporaryPasswordInput">Confirm temporary password <em>Required</em></label><asp:TextBox ID="ConfirmTemporaryPasswordInput" runat="server" TextMode="Password" MaxLength="128" autocomplete="new-password" /><asp:RequiredFieldValidator ID="ConfirmTemporaryPasswordRequired" runat="server" ControlToValidate="ConfirmTemporaryPasswordInput" ValidationGroup="ResetPassword" ErrorMessage="Confirm the temporary password." CssClass="field-error" Display="Dynamic" /><asp:CompareValidator ID="TemporaryPasswordMatch" runat="server" ControlToValidate="ConfirmTemporaryPasswordInput" ControlToCompare="TemporaryPasswordInput" ValidationGroup="ResetPassword" ErrorMessage="The temporary passwords do not match." CssClass="field-error" Display="Dynamic" /></div></div><div class="reset-warning"><i class="bi bi-exclamation-triangle"></i><span>Share the temporary password through an approved private channel. Never place it in a ticket or email thread.</span></div></div><div class="edit-actions"><asp:Button ID="ResetPasswordButton" runat="server" Text="Reset employee password" CssClass="button button-primary" ValidationGroup="ResetPassword" /></div></section>
</asp:Content>
