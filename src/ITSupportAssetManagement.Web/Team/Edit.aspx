<%@ Page Title="Edit team member" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Edit.aspx.vb" Inherits="ITSupportAssetManagement.Web.TeamEditPage" %>
<asp:Content ID="TeamEditContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading ticket-page-heading"><div><a class="back-link" href="List.aspx"><i class="bi bi-arrow-left"></i> Back to team</a><h1>Edit team member</h1><p>Maintain identity, contact details, department, and platform role.</p></div></div><asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
<section class="panel edit-form"><div class="form-body"><div class="form-row"><div class="field"><label>First name</label><asp:TextBox ID="FirstNameInput" runat="server" MaxLength="80" /></div><div class="field"><label>Last name</label><asp:TextBox ID="LastNameInput" runat="server" MaxLength="80" /></div></div><div class="form-row"><div class="field"><label>Employee code</label><asp:TextBox ID="EmployeeCodeInput" runat="server" MaxLength="30" /></div><div class="field"><label>Department</label><asp:TextBox ID="DepartmentInput" runat="server" MaxLength="100" /></div></div><div class="form-row"><div class="field"><label>Email</label><asp:TextBox ID="EmailInput" runat="server" TextMode="Email" MaxLength="254" /></div><div class="field"><label>Phone</label><asp:TextBox ID="PhoneInput" runat="server" MaxLength="30" /></div></div><div class="field"><label>Platform role</label><asp:DropDownList ID="RoleInput" runat="server" /><span class="field-help">Your own role cannot be changed while you are signed in.</span></div></div><div class="edit-actions"><a class="button button-secondary" href="List.aspx">Cancel</a><asp:Button ID="SaveButton" runat="server" Text="Save team member" CssClass="button button-primary" /></div></section>
</asp:Content>
