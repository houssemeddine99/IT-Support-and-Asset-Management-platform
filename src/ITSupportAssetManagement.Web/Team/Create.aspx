<%@ Page Title="Add team member" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Create.aspx.vb" Inherits="ITSupportAssetManagement.Web.TeamCreatePage" %>
<asp:Content ID="TeamCreateContent" ContentPlaceHolderID="MainContent" runat="server">
    <div class="page-heading ticket-page-heading"><div><a class="back-link" href="List.aspx"><i class="bi bi-arrow-left"></i> Back to team</a><h1>Add a team member</h1><p>Create a secure employee account and assign platform responsibilities.</p></div></div>
    <asp:Panel ID="ErrorPanel" runat="server" CssClass="page-alert error" Visible="false"><i class="bi bi-exclamation-circle"></i><asp:Literal ID="ErrorMessage" runat="server" /></asp:Panel>
    <div class="ticket-form-grid"><section class="panel form-panel"><div class="form-section"><div class="section-number">1</div><div class="section-copy"><h2>Identity and contact</h2><p>Employee information used across operational records.</p></div></div><div class="form-body"><div class="form-row"><div class="field"><label for="FirstNameInput">First name <em>Required</em></label><asp:TextBox ID="FirstNameInput" runat="server" MaxLength="80" /><asp:RequiredFieldValidator ID="FirstNameRequired" runat="server" ControlToValidate="FirstNameInput" ErrorMessage="First name is required." CssClass="field-error" Display="Dynamic" /></div><div class="field"><label for="LastNameInput">Last name <em>Required</em></label><asp:TextBox ID="LastNameInput" runat="server" MaxLength="80" /><asp:RequiredFieldValidator ID="LastNameRequired" runat="server" ControlToValidate="LastNameInput" ErrorMessage="Last name is required." CssClass="field-error" Display="Dynamic" /></div></div><div class="form-row"><div class="field"><label for="EmployeeCodeInput">Employee code</label><asp:TextBox ID="EmployeeCodeInput" runat="server" MaxLength="30" placeholder="DRX-00001" /></div><div class="field"><label for="DepartmentInput">Department</label><asp:TextBox ID="DepartmentInput" runat="server" MaxLength="100" placeholder="IT Infrastructure" /></div></div><div class="form-row"><div class="field"><label for="EmailInput">Work email <em>Required</em></label><asp:TextBox ID="EmailInput" runat="server" TextMode="Email" MaxLength="254" /><asp:RequiredFieldValidator ID="EmailRequired" runat="server" ControlToValidate="EmailInput" ErrorMessage="Email is required." CssClass="field-error" Display="Dynamic" /></div><div class="field"><label for="PhoneInput">Phone number</label><asp:TextBox ID="PhoneInput" runat="server" MaxLength="30" /></div></div></div>
        <div class="form-section"><div class="section-number">2</div><div class="section-copy"><h2>Access and security</h2><p>Choose least-privilege access and a temporary password.</p></div></div><div class="form-body"><div class="form-row"><div class="field"><label for="RoleInput">Platform role <em>Required</em></label><asp:DropDownList ID="RoleInput" runat="server" /><asp:RequiredFieldValidator ID="RoleRequired" runat="server" ControlToValidate="RoleInput" InitialValue="" ErrorMessage="Select a role." CssClass="field-error" Display="Dynamic" /></div><div class="field"><label for="PasswordInput">Temporary password <em>Required</em></label><asp:TextBox ID="PasswordInput" runat="server" TextMode="Password" MaxLength="128" /><asp:RequiredFieldValidator ID="PasswordRequired" runat="server" ControlToValidate="PasswordInput" ErrorMessage="Password is required." CssClass="field-error" Display="Dynamic" /><span class="field-help">12+ characters with uppercase, lowercase, number, and symbol.</span></div></div></div></section>
        <aside class="form-sidebar"><section class="assignment-guidance"><span class="guidance-icon"><i class="bi bi-person-lock"></i></span><h2>Access principles</h2><p>Assign only the permissions needed for the employee&rsquo;s responsibilities.</p><ul><li>Administrator: full platform control</li><li>IT Manager: operational oversight</li><li>Technician: ticket and maintenance execution</li><li>Employee: request submission</li></ul></section><div class="form-actions"><a class="button button-secondary" href="List.aspx">Cancel</a><asp:Button ID="CreateButton" runat="server" Text="Create account" CssClass="button button-primary" /></div></aside></div>
</asp:Content>
